#!/bin/bash
# fibocom-l850-ctl — enable/disable the LTE data interface for the GNOME toggle.
#
# 本地补丁（2026-09-20，作者 xmm + Codex），相对上游 v2 只有两处：
#   1) link_is_up() 除了看链路状态，还要求 wwan0 **有 IPv4**。
#      上游只看 `state UP|UNKNOWN`，而 xmm7360 的 wwan0 即使数据会话没建立也一直是
#      UP，于是"已开但没网"时它认为状态正常、不做任何补救（面板也就永远 0 信号）。
#   2) "on" 不再自己重载模块，而是把重试交给 fibocom-l850-up.service
#      （它现在的 ExecStart 是 fibocom-l850-up-retry，内置上游 issue #186 的
#      "不重载模块先重跑几次"策略），并立刻返回，让面板按 10 秒轮询看结果。
#
# Part of fibocom-l850-gnome-lte. SPDX-License-Identifier: GPL-3.0-or-later
set -u

IFACE=wwan0
CONF=/etc/fibocom-l850-lte/modem.conf
METRIC=1000
[ -r "$CONF" ] && . "$CONF"

# 可用 = 链路起来了 **且** 有 IPv4 **且真能通**（ping 一次）
# 为什么要 ping：会话进程退出后，IP 和路由会残留成"陈旧地址"，
# 只看 state/inet 会误判为在线，导致"已连接但没网"时自愈不触发。
PROBE_IP="${PROBE_IP:-}"
if [ -z "$PROBE_IP" ]; then
    # 优先用 modem.conf 里的第一个 DNS 做连通性探测，其次阿里 DNS
    PROBE_IP=$(printf '%s' "${DNS:-}" | tr -d '"' | awk '{print $1}')
    [ -n "$PROBE_IP" ] || PROBE_IP=223.5.5.5
fi

# $1=1 时做连通性探测（默认做；设 SKIP_PROBE=1 可跳过）
link_is_up() {
    ip link show "$IFACE" 2>/dev/null | grep -qE 'state (UP|UNKNOWN)' &&
        ip -4 addr show "$IFACE" 2>/dev/null | grep -q 'inet '
    [ "${SKIP_PROBE:-0}" = "1" ] && return $?
    ping -c 1 -W 2 -I "$IFACE" "$PROBE_IP" >/dev/null 2>&1
}

ensure_route() {
    if ! ip route show default dev "$IFACE" 2>/dev/null | grep -q .; then
        ip route add default dev "$IFACE" metric "$METRIC" 2>/dev/null || true
    fi
}

# 尝试把链路拉到可用状态；返回 0 表示 wwan0 真的有 IPv4 了
try_up() {
    if ! ip link show "$IFACE" >/dev/null 2>&1; then
        # 接口不存在（首次/刚重载模块）：交给 ensure 服务
        systemctl --no-block start fibocom-l850-up.service 2>/dev/null || true
    fi
    ip link set "$IFACE" up 2>/dev/null || true
    for _ in 1 2 3 4 5; do
        link_is_up && return 0
        sleep 1
    done
    return 1
}

case "${1:-}" in
  on)
    # 如果 ensure 正在跑，别打断它！否则每次事件都 restart 一次 bring-up，
    # 它会永远跑不完（2026-09-20 实测：IPv6 RA 抖动让守护每 15 秒触发一次）。
    state=$(systemctl is-active fibocom-l850-up.service 2>/dev/null || true)
    if [ "$state" = "activating" ] || pgrep -f 'fibocom-l850-up-retry' >/dev/null 2>&1; then
        echo "ensure 正在运行（$state），本次不打断" >&2
        exit 0
    fi
    if try_up; then
        ensure_route
    else
        echo "wwan0 还没有 IPv4 → 交给 ensure 服务在后台重试（#186 策略）" >&2
        systemctl --no-block restart fibocom-l850-up.service 2>/dev/null || true
    fi
    ;;
  off)
    if ip link show "$IFACE" >/dev/null 2>&1; then
      ip link set "$IFACE" down
    fi
    ;;
  status)
    if link_is_up; then
      echo on
    else
      echo off
    fi
    ;;
  *)
    echo "usage: $0 {on|off|status}" >&2
    exit 2
    ;;
esac
