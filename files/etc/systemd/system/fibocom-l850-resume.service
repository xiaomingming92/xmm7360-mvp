[Unit]
Description=Fibocom L850 (XMM7360) 挂起/休眠恢复后重新拉起移动数据
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
# 睡眠 5 秒让设备枚举完，再用与开机同一条 ensure 逻辑（带 #186 式重试）
ExecStart=/bin/sh -c 'sleep 5; exec /usr/local/bin/fibocom-l850-up-retry'
TimeoutStartSec=900

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
